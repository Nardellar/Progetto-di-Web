<h2 class="heading">Servizi</h2>
<% if (serviziStruttura && serviziStruttura.length) { %>
<ul>
    <% serviziStruttura.forEach(function(service) { %>
    <li>
        <a>
            <% if (service.icona === 'material') { %>
            <i class="material-icons icone-side" aria-hidden="true"><%= service.valore_icona %></i>
            <% } else { %>
            <i class="fa <%= service.valore_icona %> icone-side" aria-hidden="true"></i>
            <% } %>
            <%= service.nome %>
        </a>
    </li>
    <% }); %>
</ul>
<% } else { %>
<p class="text-muted">Nessun servizio configurato.</p>
<% } %>


