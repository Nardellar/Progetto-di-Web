<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Simone Nardella">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link href="/stylesheets/style.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/font-awesome.min.css">
    <link rel="stylesheet" href="/stylesheets/notifications.css">
    <link rel="stylesheet" href="/stylesheets/gestione.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Dosis:300,400,500,600,700,800" rel="stylesheet">
</head>

<body>
    <header class="header" id="header">
        <%- include('partials/navbar') %>
    </header>

    <main class="gestione-page">
        <div class="container">
            <h1>Gestione strutture</h1>
            <p class="lead">Benvenuto, <%= user.nome %>. Qui puoi gestire le tue strutture, le prenotazioni e rispondere alle domande.</p>

            <%- include('partials/notifications') %>

            <button type="button" class="btn btn-primary gestione-add-toggle" data-target="#new-facility-panel">
                <i class="fa fa-plus-circle"></i> Aggiungi struttura
            </button>

            <div class="panel panel-default gestione-add-panel" id="new-facility-panel" aria-hidden="true">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-plus-circle"></i> Aggiungi una nuova struttura</h3>
                </div>
                <div class="panel-body">
                    <form action="/struttura/nuova" method="post" class="gestione-inline-form" id="new-facility-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="nuova-nome">Nome struttura</label>
                                    <input id="nuova-nome" name="nome" class="form-control" type="text" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="nuova-cammino">Cammino</label>
                                    <select id="nuova-cammino" name="id_cammino" class="form-control js-gestione-cammino" required>
                                        <option value="">Seleziona un cammino</option>
                                        <% (cammini || []).forEach(function(cammino) { %>
                                        <option value="<%= cammino.id %>"><%= cammino.nome %></option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="nuova-tappa">Tappa del cammino</label>
                                    <select id="nuova-tappa" name="tappa" class="form-control js-gestione-tappa" required disabled>
                                        <option value="">Seleziona prima un cammino</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="nuova-prezzo-notte">Prezzo per notte (&euro;)</label>
                                    <input id="nuova-prezzo-notte" name="prezzo_notte" class="form-control" type="number" min="0" step="0.01" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="nuova-descrizione">Descrizione (opzionale)</label>
                            <textarea id="nuova-descrizione" name="descrizione" class="form-control" rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Crea struttura</button>
                    </form>
                </div>
            </div>

            <% if (strutture.length === 0) { %>
            <div class="alert alert-info">Non hai ancora strutture registrate.</div>
            <% } %>

            <% strutture.forEach(function(struttura) { %>
            <article class="panel panel-primary" id="struttura-<%= struttura.id %>">
                <div class="panel-heading gestione-panel-heading">
                    <h3 class="panel-title gestione-panel-title">
                        <i class="fa fa-building"></i> <%= struttura.nome %> &mdash; <%= struttura.citta %>
                    </h3>
                    <div class="gestione-panel-actions">
                        <a href="/struttura/<%= struttura.id %>" class="btn btn-sm gestione-public-page-btn">Visualizza pagina pubblica</a>
                        <form action="/struttura/<%= struttura.id %>/elimina" method="post" class="gestione-inline-delete" onsubmit="return confirm('Vuoi eliminare definitivamente questa struttura?');">
                            <button type="submit" class="btn btn-danger btn-sm">Elimina</button>
                        </form>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-3 gestione-media-col" data-structure-name="<%= struttura.nome %>">
                            <% const immagineStruttura = struttura.immagine ? (struttura.immagine.startsWith('http') ? struttura.immagine : ('/images/' + struttura.immagine)) : null; %>
                            <% let anteprimaUrl = immagineStruttura;
                               if (!anteprimaUrl && struttura.immagini && struttura.immagini.length) {
                                 const prima = struttura.immagini[0];
                                 anteprimaUrl = prima.percorso_immagine.startsWith('http') ? prima.percorso_immagine : ('/images/' + prima.percorso_immagine);
                               } %>
                            <div class="gestione-preview-slot">
                                <% if (anteprimaUrl) { %>
                                <img src="<%= anteprimaUrl %>" alt="<%= struttura.nome %>" class="img-responsive gestione-facility-image gestione-preview-main">
                                <% } else { %>
                                <p class="text-muted gestione-preview-empty">Nessuna immagine caricata.</p>
                                <% } %>
                            </div>

                            <h5>Galleria immagini (<%= (struttura.immagini || []).length %>)</h5>
                            <% if (struttura.immagini && struttura.immagini.length) { %>
                            <div class="gestione-gallery-list">
                                <% struttura.immagini.forEach(function(img) { %>
                                <% const imgUrl = img.percorso_immagine.startsWith('http') ? img.percorso_immagine : ('/images/' + img.percorso_immagine); %>
                                <% const isSelected = anteprimaUrl === imgUrl; %>
                                <div class="gestione-gallery-item">
                                    <img src="<%= imgUrl %>" alt="Immagine struttura — clic per anteprima" class="img-responsive gestione-gallery-thumb gestione-gallery-thumb-selectable<%= isSelected ? ' is-selected' : '' %>" data-preview-src="<%= imgUrl %>" tabindex="0" role="button">
                                    <form action="/struttura/<%= struttura.id %>/immagine/elimina" method="post" class="gestione-gallery-delete-form">
                                        <input type="hidden" name="image_id" value="<%= img.id %>">
                                        <button type="submit" class="btn btn-danger btn-xs" onclick="return confirm('Vuoi eliminare questa immagine?')">Elimina</button>
                                    </form>
                                </div>
                                <% }); %>
                            </div>
                            <% } %>

                            <form action="/struttura/<%= struttura.id %>/immagine" method="post" enctype="multipart/form-data" class="gestione-inline-form">
                                <div class="form-group">
                                    <label for="immagine-struttura-<%= struttura.id %>">Aggiungi immagine galleria</label>
                                    <input id="immagine-struttura-<%= struttura.id %>" type="file" name="immagine_struttura" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">Aggiungi immagine</button>
                            </form>

                            <hr>
                            <ul class="list-unstyled">
                                <% if (struttura.prezzo_notte) { %>
                                <li><strong>Prezzo:</strong> &euro;<%= struttura.prezzo_notte.toFixed(2) %>/notte</li>
                                <% } %>
                                <% if (struttura.capacita) { %>
                                <li><strong>Capacità:</strong> <%= struttura.capacita %> ospiti</li>
                                <% } %>
                            </ul>
                            <form action="/struttura/<%= struttura.id %>/dettagli" method="post" class="gestione-inline-form">
                                <div class="form-group">
                                    <label for="nome-struttura-<%= struttura.id %>">Nome struttura</label>
                                    <input id="nome-struttura-<%= struttura.id %>" name="nome" class="form-control" type="text" maxlength="120" value="<%= struttura.nome %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="cammino-struttura-<%= struttura.id %>">Cammino</label>
                                    <select id="cammino-struttura-<%= struttura.id %>" name="id_cammino" class="form-control js-gestione-cammino" required>
                                        <% (cammini || []).forEach(function(cammino) { %>
                                        <option value="<%= cammino.id %>" <%= cammino.id === struttura.id_cammino ? 'selected' : '' %>><%= cammino.nome %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="tappa-struttura-<%= struttura.id %>">Tappa del cammino</label>
                                    <select id="tappa-struttura-<%= struttura.id %>" name="tappa" class="form-control js-gestione-tappa" data-selected-tappa="<%= struttura.current_tappa_value || '' %>" required></select>
                                </div>
                                <div class="form-group">
                                    <label for="prezzo-notte-<%= struttura.id %>">Prezzo per notte (&euro;)</label>
                                    <input id="prezzo-notte-<%= struttura.id %>" name="prezzo_notte" class="form-control" type="number" min="0" step="0.01" value="<%= struttura.prezzo_notte != null ? Number(struttura.prezzo_notte).toFixed(2) : '' %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="capacita-<%= struttura.id %>">Capacità massima ospiti</label>
                                    <input id="capacita-<%= struttura.id %>" name="capacita" class="form-control" type="number" min="1" max="1000" value="<%= struttura.capacita || 1 %>" required>
                                </div>
                                <button type="submit" class="btn btn-success btn-sm">Salva dettagli struttura</button>
                            </form>

                            <hr>
                            <form action="/struttura/<%= struttura.id %>/servizi" method="post" class="gestione-inline-form gestione-services-form">
                                <h5>Servizi disponibili</h5>
                                <% if (catalogoServizi && catalogoServizi.length) { %>
                                <div class="gestione-services-list">
                                    <% catalogoServizi.forEach(function(servizio) { %>
                                    <% const isChecked = (struttura.service_ids || []).indexOf(servizio.id) !== -1; %>
                                    <label class="gestione-service-item" for="service-<%= struttura.id %>-<%= servizio.id %>">
                                        <input id="service-<%= struttura.id %>-<%= servizio.id %>" type="checkbox" name="service_ids" value="<%= servizio.id %>" <%= isChecked ? 'checked' : '' %>>
                                        <% if (servizio.icona === 'material') { %>
                                        <i class="material-icons" aria-hidden="true"><%= servizio.valore_icona %></i>
                                        <% } else { %>
                                        <i class="fa <%= servizio.valore_icona %>" aria-hidden="true"></i>
                                        <% } %>
                                        <span><%= servizio.nome %></span>
                                    </label>
                                    <% }); %>
                                </div>
                                <button type="submit" class="btn btn-info btn-sm">Salva servizi</button>
                                <% } else { %>
                                <p class="text-muted">Nessun servizio predefinito disponibile.</p>
                                <% } %>
                            </form>
                        </div>
                        <div class="col-md-9">

                            <!-- PRENOTAZIONI -->
                            <h4><i class="fa fa-calendar"></i> Prenotazioni (<%= struttura.prenotazioni.length %>)</h4>
                            <% if (struttura.prenotazioni.length === 0) { %>
                            <p class="text-muted">Nessuna prenotazione ricevuta.</p>
                            <% } else { %>
                            <table class="table table-condensed table-hover">
                                <thead>
                                    <tr>
                                        <th>Ospite</th>
                                        <th>Check-in</th>
                                        <th>Check-out</th>
                                        <th>Ospiti</th>
                                        <th>Stato</th>
                                        <th>Azioni</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% struttura.prenotazioni.forEach(function(prenotazione) { %>
                                    <tr class="<%= prenotazione.status === 'pending' ? 'warning' : (prenotazione.status === 'accepted' ? 'success' : 'danger') %>">
                                        <td><%= prenotazione.nome_camminatore %> <%= prenotazione.cognome_camminatore %><br><small class="text-muted"><%= prenotazione.email_camminatore %></small></td>
                                        <td><%= new Date(prenotazione.check_in).toLocaleDateString('it-IT') %></td>
                                        <td><%= new Date(prenotazione.check_out).toLocaleDateString('it-IT') %></td>
                                        <td><%= prenotazione.numero_ospiti %></td>
                                        <td>
                                            <% if (prenotazione.status === 'pending') { %>
                                            <span class="label label-warning">In attesa</span>
                                            <% } else if (prenotazione.status === 'accepted') { %>
                                            <span class="label label-success">Accettata</span>
                                            <% } else { %>
                                            <span class="label label-danger">Rifiutata</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (prenotazione.status === 'pending') { %>
                                            <form action="/prenotazione/<%= prenotazione.id %>/aggiorna" method="post" style="display:inline">
                                                <input type="hidden" name="status" value="accepted">
                                                <button type="submit" class="btn btn-success btn-xs"><i class="fa fa-check"></i> Accetta</button>
                                            </form>
                                            <form action="/prenotazione/<%= prenotazione.id %>/aggiorna" method="post" style="display:inline">
                                                <input type="hidden" name="status" value="rejected">
                                                <button type="submit" class="btn btn-danger btn-xs"><i class="fa fa-times"></i> Rifiuta</button>
                                            </form>
                                            <% } else { %>
                                            <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                            <% } %>

                            <hr>

                            <!-- DOMANDE (solo senza risposta) -->
                            <h4><i class="fa fa-comments"></i> Domande in attesa (<%= struttura.domande.length %>)</h4>
                            <% if (struttura.domande.length === 0) { %>
                            <p class="text-muted">Nessuna domanda in attesa di risposta.</p>
                            <% } else { %>
                            <% struttura.domande.forEach(function(domanda) { %>
                            <div class="well well-sm">
                                <div class="row">
                                    <div class="col-md-8">
                                        <strong><%= domanda.nome_autore %></strong>
                                        <% if (!domanda.email_autore) { %><small>(Anonimo)</small><% } %>
                                        <span class="text-muted pull-right">
                                            <%= new Date(domanda.creato_il).toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                        </span>
                                        <p style="margin-top:5px"><%= domanda.testo %></p>
                                    </div>
                                    <div class="col-md-4">
                                        <form action="/domanda/<%= domanda.id %>/rispondi" method="post">
                                            <div class="form-group gestione-reply-field">
                                                <label for="risposta-<%= domanda.id %>" class="sr-only">Risposta alla domanda</label>
                                                <textarea id="risposta-<%= domanda.id %>" name="testo" class="form-control input-sm" rows="2" placeholder="Scrivi la tua risposta..." required></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-xs"><i class="fa fa-reply"></i> Rispondi</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                            <% } %>

                        </div>
                    </div>
                </div>
            </article>
            <% }); %>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/javascripts/jquery.min.js"></script>
    <script src="/javascripts/bootstrap.min.js"></script>
    <script src="/javascripts/notifications.js"></script>
    <script src="/javascripts/gestione-gallery-preview.js"></script>
    <script>
        (function () {
            var cammini = <%- JSON.stringify(cammini || []) %>;
            var toggle = document.querySelector('.gestione-add-toggle');
            var panel = document.querySelector('#new-facility-panel');
            var camminoSelect = document.getElementById('nuova-cammino');
            var tappaSelect = document.getElementById('nuova-tappa');

            if (toggle && panel) {
                toggle.addEventListener('click', function () {
                    var isOpen = panel.classList.toggle('is-open');
                    panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
                });
            }

            function updateTappeOptions(camminoSelectEl, tappaSelectEl, selectedTappaValue) {
                var selectedId = Number(camminoSelectEl.value || 0);
                var cammino = cammini.find(function (t) { return t.id === selectedId; });
                tappaSelectEl.innerHTML = '';

                if (!cammino || !cammino.tappe || !cammino.tappe.length) {
                    tappaSelectEl.disabled = true;
                    var option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'Nessuna tappa disponibile';
                    tappaSelectEl.appendChild(option);
                    return;
                }

                tappaSelectEl.disabled = false;
                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = 'Seleziona una tappa';
                tappaSelectEl.appendChild(placeholder);

                cammino.tappe.forEach(function (tappa) {
                    var option = document.createElement('option');
                    option.value = tappa.value;
                    option.textContent = tappa.label;
                    if (selectedTappaValue && tappa.value === selectedTappaValue) {
                        option.selected = true;
                    }
                    tappaSelectEl.appendChild(option);
                });
            }

            if (camminoSelect && tappaSelect) {
                camminoSelect.addEventListener('change', function () {
                    updateTappeOptions(camminoSelect, tappaSelect, '');
                });
                updateTappeOptions(camminoSelect, tappaSelect, tappaSelect.getAttribute('data-selected-tappa') || '');
            }

            var camminoSelectList = document.querySelectorAll('.js-gestione-cammino');
            for (var i = 0; i < camminoSelectList.length; i += 1) {
                var currentCamminoSelect = camminoSelectList[i];
                if (currentCamminoSelect.id === 'nuova-cammino') {
                    continue;
                }

                var currentTappaSelect = currentCamminoSelect
                    .closest('form')
                    .querySelector('.js-gestione-tappa');
                if (!currentTappaSelect) {
                    continue;
                }

                (function (camminoEl, tappaEl) {
                    camminoEl.addEventListener('change', function () {
                        updateTappeOptions(camminoEl, tappaEl, '');
                    });
                    updateTappeOptions(camminoEl, tappaEl, tappaEl.getAttribute('data-selected-tappa') || '');
                })(currentCamminoSelect, currentTappaSelect);
            }
        })();
    </script>
</body>

</html>
