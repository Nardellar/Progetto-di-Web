<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= cammino.nome %> - dettaglio cammino">
    <meta name="author" content="Simone Nardella">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/font-awesome.min.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/via-degli-dei-modern.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
</head>

<body>
    <header class="header" id="header">
        <%- include('partials/navbar') %>
    </header>

    <% var details = trailDetails || null; %>
    <% var dettaglioTappe = details && details.tappe ? details.tappe : null; %>
    <% var totalStages = (dettaglioTappe && dettaglioTappe.length) || cammino.numero_tappe || 1; %>

    <section class="vddm-hero">
        <div class="container">
            <div class="vddm-hero-box">
                <p class="kicker"><%= (details && details.kicker) || 'Cammino' %></p>
                <h1><%= cammino.nome %></h1>
                <p class="subtitle"><%= (details && details.subtitle) || cammino.descrizione || ('Da ' + cammino.citta_partenza + ' a ' + cammino.citta_arrivo + ' lungo un itinerario ricco di natura e borghi.') %></p>
                <a href="/strutture?cammino=<%= cammino.slug %>" class="btn btn-warning btn-lg vddm-hero-cta">
                    <i class="fa fa-bed"></i> Prenota ora
                </a>
            </div>
        </div>
    </section>

    <main class="vddm-main">
        <section class="container">
            <div class="row vddm-top-row">
                <div class="col-md-8 vddm-left-col">
                    <div class="vddm-section-title">
                        <h2>Tappe del percorso</h2>
                    </div>

                    <% if (details && details.intro) { %>
                    <div class="vddm-stage-card">
                        <p><%= details.intro %></p>
                        <% if (details.notaTappeClassiche) { %>
                        <p><strong><%= details.notaTappeClassiche %></strong></p>
                        <% } %>
                    </div>
                    <% } %>

                    <% if (totalStages > 6) { %>
                    <div class="vddm-stage-pager" data-stage-pager>
                        <button type="button" class="btn btn-default btn-sm vddm-stage-pager-btn" data-stage-prev aria-label="Mostra le 6 tappe precedenti">
                            <i class="fa fa-chevron-left" aria-hidden="true"></i>
                        </button>
                        <span class="vddm-stage-pager-label" data-stage-page-label></span>
                        <button type="button" class="btn btn-default btn-sm vddm-stage-pager-btn" data-stage-next aria-label="Mostra le 6 tappe successive">
                            <i class="fa fa-chevron-right" aria-hidden="true"></i>
                        </button>
                    </div>
                    <% } %>

                    <div class="panel-group vddm-accordion" id="trailAccordion" role="tablist" aria-multiselectable="true" data-stage-page-size="6">
                        <% for (var i = 1; i <= totalStages; i++) { %>
                        <% var stage = dettaglioTappe ? dettaglioTappe[i - 1] : null; %>
                        <div class="panel panel-default vddm-stage-panel" data-stage-index="<%= i - 1 %>">
                            <div class="panel-heading" role="tab" id="trailHeading<%= i %>">
                                <h4 class="panel-title">
                                    <a class="<%= i === 1 ? '' : 'collapsed' %>" role="button" data-toggle="collapse" data-parent="#trailAccordion" href="#trailCollapse<%= i %>" aria-expanded="<%= i === 1 ? 'true' : 'false' %>" aria-controls="trailCollapse<%= i %>">
                                        <%= i %>) <%= stage ? stage.titolo : ('Tappa ' + i) %>
                                    </a>
                                </h4>
                            </div>
                            <div id="trailCollapse<%= i %>" class="panel-collapse collapse<%= i === 1 ? ' in' : '' %>" role="tabpanel" aria-labelledby="trailHeading<%= i %>">
                                <div class="panel-body">
                                    <% var stageLength = null; %>
                                    <% if (stage) { %>
                                    <% stageLength = stage.lunghezza || stage.lunghezzaTot || stage.distanza || null; %>
                                    <% if (!stageLength && stage.titolo) { %>
                                    <% var lengthMatch = String(stage.titolo).match(/\(([^)]*km[^)]*)\)/i); %>
                                    <% if (lengthMatch && lengthMatch[1]) { stageLength = lengthMatch[1]; } %>
                                    <% } %>
                                    <% } %>
                                    <div class="vddm-stage-meta">
                                        <% if (stage && stage.tempo) { %>
                                        <span>Tempo: <%= stage.tempo %></span>
                                        <% } %>
                                        <% if (stageLength) { %>
                                        <span>Lunghezza: <%= stageLength %></span>
                                        <% } %>
                                        <% if (stage && stage.dislivello) { %>
                                        <span>Dislivello: <%= stage.dislivello %></span>
                                        <% } %>
                                    </div>
                                    <% if (stage && stage.descrizione) { %>
                                    <p><%= stage.descrizione %></p>
                                    <% } else { %>
                                    <p>
                                        Questa sezione raccoglie la tappa <%= i %> del cammino <strong><%= cammino.nome %></strong>.
                                        Personalizza il testo con dettagli locali (punti acqua, dislivello e tempi) quando li avrai disponibili.
                                    </p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <div class="vddm-booking-wrap">
                        <a href="/strutture?cammino=<%= cammino.slug %>" class="btn btn-warning btn-lg vddm-booking-cta">
                            <i class="fa fa-bed"></i> Prenota ora
                        </a>
                    </div>
                </div>

                <aside class="col-md-4 vddm-right-col">
                    <div class="vddm-info-card">
                        <h3><i class="fa fa-map-signs"></i> Info generali</h3>
                        <ul>
                            <li><strong>Partenza:</strong> <%= cammino.citta_partenza %></li>
                            <li><strong>Arrivo:</strong> <%= cammino.citta_arrivo %></li>
                            <% if (cammino.regione) { %>
                            <li><strong>Regione:</strong> <%= cammino.regione %></li>
                            <% } %>
                            <% if (cammino.numero_tappe) { %>
                            <li><strong>Tappe:</strong> <%= cammino.numero_tappe %></li>
                            <% } %>
                            <% if (cammino.lunghezza_totale_km) { %>
                            <li><strong>Lunghezza totale:</strong> <%= cammino.lunghezza_totale_km %> km</li>
                            <% } %>
                            <% if (cammino.stagione_ideale) { %>
                            <li><strong>Stagione ideale:</strong> <%= cammino.stagione_ideale %></li>
                            <% } %>
                        </ul>
                    </div>

                    <div class="vddm-gallery-title">
                        <h3>Galleria cammino</h3>
                    </div>
                    <% var galleryImages = []; %>
                    <% if (details && details.galleryImages && details.galleryImages.length) { %>
                    <% galleryImages = details.galleryImages.map(function(img) { return img.startsWith('http') ? img : ('/images/' + img); }); %>
                    <% } %>
<!--                    se ho immagini per il carosello aggiungi carosello-->
                    <% if (galleryImages.length) { %>
                    <div id="trailGallery" class="carousel slide vddm-carousel" data-ride="carousel" data-interval="4000">
                        <div class="carousel-inner" role="listbox">
                            <% galleryImages.forEach(function(img, index) { %>
                            <div class="item<%= index === 0 ? ' active' : '' %>">
                                <img src="<%= img %>" alt="<%= cammino.nome %> - panorama <%= index + 1 %>">
                            </div>
                            <% }); %>
                        </div>
                        <% if (galleryImages.length > 1) { %>
                        <a class="left carousel-control" href="#trailGallery" role="button" data-slide="prev">
                            <span class="fa fa-chevron-left" aria-hidden="true"></span>
                            <span class="sr-only">Precedente</span>
                        </a>
                        <a class="right carousel-control" href="#trailGallery" role="button" data-slide="next">
                            <span class="fa fa-chevron-right" aria-hidden="true"></span>
                            <span class="sr-only">Successiva</span>
                        </a>
                        <% } %>
                    </div>
                    <% } else { %>
                    <div class="vddm-stage-card">
                        <p>Nessuna immagine disponibile per questo cammino.</p>
                    </div>
                    <% } %>
                </aside>
            </div>
        </section>

        <% if (strutture && strutture.length > 0) { %>
        <section class="container vddm-facilities">
            <div class="vddm-section-title">
                <h2>Strutture lungo il percorso</h2>
            </div>
            <div class="row">
                <% strutture.forEach(function(struttura) { %>
                <div class="col-md-4 col-sm-6 vddm-facility-col">
                    <article class="vddm-facility-card">
                        <% if (struttura.immagine) { %>
                        <img src="/images/<%= struttura.immagine %>" alt="<%= struttura.nome %>">
                        <% } else { %>
                        <div class="placeholder"><i class="fa fa-home fa-3x"></i></div>
                        <% } %>
                        <div class="body">
                            <h4><%= struttura.nome %></h4>
                            <p><i class="fa fa-map-marker"></i> <%= struttura.citta %></p>
                            <% if (struttura.prezzo_notte) { %>
                            <p><strong>&euro;<%= struttura.prezzo_notte.toFixed(2) %></strong> / notte</p>
                            <% } %>
                            <a href="/struttura/<%= struttura.id %>" class="btn btn-primary btn-lg">Dettagli e prenota</a>
                        </div>
                    </article>
                </div>
                <% }); %>
            </div>
        </section>
        <% } %>

        <section class="container vddm-map-section">
            <div class="vddm-section-title">
                <h2>Mappa interattiva</h2>
            </div>
            <div id="trail-map" class="vddm-map" data-gpx-map data-gpx="<%= details && details.gpxFile ? ('/gpx/' + details.gpxFile) : '' %>"></div>
            <p class="vddm-map-note" data-gpx-note hidden>Traccia GPX non disponibile per questo cammino.</p>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/javascripts/jquery.min.js"></script>
    <script src="/javascripts/bootstrap.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="/javascripts/trail-map.js"></script>
    <script src="/javascripts/trail-stage-pagination.js"></script>
</body>

</html>
